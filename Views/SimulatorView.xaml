<UserControl x:Class="FuelQ.Views.SimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FuelQ.Controls"
             Background="{StaticResource CanvasBackground}"
             FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,32">

            <!-- ══ PAGE HEADER ══ -->
            <TextBlock Text="Shell Petrol Pump — Discrete Event Simulator (DES)" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
            <TextBlock Text="Stochastic event-by-event progression simulating individual customer vehicle arrivals, pump allocation, queuing, fueling, and departures."
                       Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,16"/>

            <!-- ══ CONFIGURATION ACCORDION / CARDS ══ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: General Settings & Arrival -->
                <Border Grid.Column="0" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="01  GENERAL RUN SETTINGS" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ACTIVE PUMPS / SERVERS (s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimServers" Text="2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TIME UNIT" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbSimTimeUnit">
                                    <ComboBoxItem Content="Minutes" IsSelected="True"/>
                                    <ComboBoxItem Content="Seconds"/>
                                    <ComboBoxItem Content="Hours"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CUSTOMER LIMIT (N)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimCustomerLimit" Text="25"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DURATION CAP (T)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimDurationCap" Text="480"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="RANDOM SEED (REPRODUCIBILITY)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbSimSeed" Text="42"/>
                        </StackPanel>

                        <Separator Background="{StaticResource CardBorder}" Margin="0,0,0,12"/>

                        <!-- Arrival Distribution -->
                        <TextBlock Text="02  ARRIVAL DISTRIBUTION" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="CbSimArrDist" SelectionChanged="SimArrDist_Changed" Margin="0,0,0,8">
                            <ComboBoxItem Content="Exponential (Poisson Arrivals)" IsSelected="True"/>
                            <ComboBoxItem Content="Uniform [a, b]"/>
                            <ComboBoxItem Content="Normal (Gaussian)"/>
                        </ComboBox>

                        <StackPanel x:Name="PanelSimArrExp" Margin="0,0,0,4">
                            <TextBlock Text="MEAN INTERARRIVAL TIME" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbSimArrExpMean" Text="3.0"/>
                            <TextBlock Text="λ = 1 ÷ this value" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Grid x:Name="PanelSimArrUniform" Visibility="Collapsed" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MIN (a)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimArrUniMin" Text="2.0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MAX (b)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimArrUniMax" Text="4.0"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PanelSimArrNormal" Visibility="Collapsed" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MEAN (μ_a)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimArrNormMean" Text="3.0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="STD DEV (σ_a)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimArrNormStd" Text="1.0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Card: Service Distribution & Action -->
                <Border Grid.Column="2" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="03  SERVICE DISTRIBUTION" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="CbSimSvcDist" SelectionChanged="SimSvcDist_Changed" Margin="0,0,0,12">
                            <ComboBoxItem Content="Exponential (Markovian Service)" IsSelected="True"/>
                            <ComboBoxItem Content="Normal (Gaussian Duration)"/>
                            <ComboBoxItem Content="Gamma (Erlang Shape/Scale)"/>
                            <ComboBoxItem Content="Uniform [a, b]"/>
                        </ComboBox>

                        <StackPanel x:Name="PanelSimSvcExp" Margin="0,0,0,8">
                            <TextBlock Text="MEAN SERVICE DURATION" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbSimSvcExpMean" Text="2.0"/>
                            <TextBlock Text="μ = 1 ÷ this value" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Grid x:Name="PanelSimSvcNormal" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MEAN (μ_s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimSvcNormMean" Text="2.0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="STD DEV (σ_s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimSvcNormStd" Text="0.8"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PanelSimSvcGamma" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SHAPE (k)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimSvcGammaShape" Text="2.0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SCALE (θ)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimSvcGammaScale" Text="1.0"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PanelSimSvcUniform" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MIN (a)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimSvcUniMin" Text="1.0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MAX (b)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbSimSvcUniMax" Text="3.0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource CardBorder}" Margin="0,8,0,16"/>

                        <!-- Action Buttons -->
                        <TextBlock Text="EXECUTE SIMULATION RUN" Style="{StaticResource FieldLabel}"/>
                        <Button x:Name="BtnRunSim" Content="▶  Run Discrete Event Simulation" Style="{StaticResource PrimaryButton}" Click="RunSim_Click" Height="40" Margin="0,0,0,8"/>
                        <Button Content="↺  Reset Defaults" Style="{StaticResource SecondaryButton}" Click="ResetSim_Click" Height="36"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ RESULTS CONTAINER ══ -->
            <StackPanel x:Name="PanelSimResults">

                <!-- ══ AGGREGATE PERFORMANCE MEASURES CARDS ══ -->
                <TextBlock Text="SIMULATION PERFORMANCE MEASURES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                <UniformGrid Columns="5" Rows="2" Margin="0,0,0,16">
                    <!-- Avg Wait -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="AVG WAITING TIME (Wq)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SimMetricAvgWq" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock x:Name="SimMetricAvgWqUnit" Text="min in queue" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <!-- Max Wait -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="MAX WAITING TIME" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SimMetricMaxWq" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                            <TextBlock x:Name="SimMetricMaxWqUnit" Text="min peak delay" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <!-- Avg Queue Len -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="AVG QUEUE LENGTH (Lq)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SimMetricAvgLq" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="vehicles in queue" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <!-- Max Queue Len -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="MAX QUEUE LENGTH" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SimMetricMaxQLen" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentRed}"/>
                            <TextBlock Text="vehicles max queue" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <!-- Server Utilization -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="SERVER UTILIZATION (ρ)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SimMetricRho" Text="0.0%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource StatusGreenText}"/>
                            <TextBlock Text="Busy pump capacity" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <!-- Avg System Time W -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="AVG SYSTEM TIME (W)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SimMetricAvgW" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="SimMetricAvgWUnit" Text="min total turnaround" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <!-- Avg System Length L -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="AVG SYSTEM LENGTH (L)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SimMetricAvgL" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="vehicles in system" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <!-- Throughput -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="SYSTEM THROUGHPUT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SimMetricThroughput" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="{StaticResource StatusGreenText}"/>
                            <TextBlock x:Name="SimMetricThroughputUnit" Text="vehicles / min" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <!-- Total Customers Served -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="CUSTOMERS PROCESSED" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SimMetricTotalServed" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="vehicles served" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <!-- Total Sim Clock -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                        <StackPanel>
                            <TextBlock Text="SIMULATION CLOCK" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="SimMetricTotalTime" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#FBBF24"/>
                            <TextBlock x:Name="SimMetricTotalTimeUnit" Text="min total elapsed" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ══ THEORETICAL VS SIMULATED COMPARISON TABLE ══ -->
                <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SIMULATED VS. THEORETICAL QUEUEING COMPARISON" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Side-by-side verification of stochastic DES outcome against theoretical Kendall steady-state formulas" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="GridComparison" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0" RowBackground="{StaticResource RowBase}" AlternatingRowBackground="{StaticResource RowAlternate}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Performance Measure" Binding="{Binding MetricName}" Width="200"/>
                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="80"/>
                                <DataGridTextColumn Header="Simulated (DES)" Binding="{Binding SimulatedValue}" Width="160"/>
                                <DataGridTextColumn Header="Theoretical" Binding="{Binding TheoreticalValue}" Width="160"/>
                                <DataGridTextColumn Header="Delta Error %" Binding="{Binding ErrorDelta}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ══ CHARTS ROW ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Q(t) Timeline Chart -->
                    <Border Grid.Column="0" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="QUEUE LENGTH OVER TIME Q(t)" Style="{StaticResource SectionLabel}"/>
                            <controls:SimpleWpfChart x:Name="ChartTimeline" Height="220" Mode="Line" XAxisLabel="Time" YAxisLabel="Queue Length"/>
                        </StackPanel>
                    </Border>

                    <!-- Waiting Time Distribution -->
                    <Border Grid.Column="2" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="WAITING TIME DISTRIBUTION HISTOGRAM" Style="{StaticResource SectionLabel}"/>
                            <controls:SimpleWpfChart x:Name="ChartWaitDist" Height="220" Mode="Bar" XAxisLabel="Delay Bin" YAxisLabel="% Vehicles"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ SECTION 1: RANDOM NUMBER DRAW TABLE ══ -->
                <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SECTION 1: PSEUDO-RANDOM NUMBER DRAWS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Random variates (0 &lt; R &lt; 1) sampled via inverse transform for Arrival and Service intervals" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="GridRandomNumbers" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="240"
                                  Background="Transparent" BorderThickness="0" RowBackground="{StaticResource RowBase}" AlternatingRowBackground="{StaticResource RowAlternate}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Customer #" Binding="{Binding CustomerNumber}" Width="100"/>
                                <DataGridTextColumn Header="Random (Arrival R_A)" Binding="{Binding ArrivalRandom, StringFormat=F4}" Width="170"/>
                                <DataGridTextColumn Header="Interarrival Time" Binding="{Binding InterarrivalTime, StringFormat=F4}" Width="150"/>
                                <DataGridTextColumn Header="Random (Service R_S)" Binding="{Binding ServiceRandom, StringFormat=F4}" Width="170"/>
                                <DataGridTextColumn Header="Service Duration" Binding="{Binding ServiceTime, StringFormat=F4}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ══ SECTION 2: EVENT-BY-EVENT SIMULATION TABLE ══ -->
                <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SECTION 2: EVENT-BY-EVENT SIMULATION TABLE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Complete chronological trace of arrival, queue entry, pump assignment, fueling start/end, and departure" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="GridEventTable" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="300"
                                  Background="Transparent" BorderThickness="0" RowBackground="{StaticResource RowBase}" AlternatingRowBackground="{StaticResource RowAlternate}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cust #" Binding="{Binding CustomerNumber}" Width="65"/>
                                <DataGridTextColumn Header="IAT" Binding="{Binding InterarrivalTime, StringFormat=F2}" Width="65"/>
                                <DataGridTextColumn Header="Arrival" Binding="{Binding ArrivalTime, StringFormat=F2}" Width="75"/>
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceTime, StringFormat=F2}" Width="75"/>
                                <DataGridTextColumn Header="Svc Begins" Binding="{Binding TimeServiceBegins, StringFormat=F2}" Width="85"/>
                                <DataGridTextColumn Header="Svc Ends" Binding="{Binding TimeServiceEnds, StringFormat=F2}" Width="85"/>
                                <DataGridTextColumn Header="Wait (Wq)" Binding="{Binding WaitingTime, StringFormat=F2}" Width="80"/>
                                <DataGridTextColumn Header="Time In Sys (W)" Binding="{Binding TimeInSystem, StringFormat=F2}" Width="105"/>
                                <DataGridTextColumn Header="Queue On Arrival" Binding="{Binding QueueLengthOnArrival}" Width="120"/>
                                <DataGridTextColumn Header="Pump #" Binding="{Binding AssignedServer}" Width="75"/>
                                <DataGridTextColumn Header="Pump Idle" Binding="{Binding IdleTimeOfServer, StringFormat=F2}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ══ SECTION 3: HOURLY SUMMARY BREAKDOWN ══ -->
                <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="SECTION 3: PERIODIC / HOURLY PERFORMANCE BREAKDOWN" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Interval metrics demonstrating queuing dynamics and server utilization across the simulation duration" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="GridHourly" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="220"
                                  Background="Transparent" BorderThickness="0" RowBackground="{StaticResource RowBase}" AlternatingRowBackground="{StaticResource RowAlternate}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Period Interval" Binding="{Binding HourPeriod}" Width="180"/>
                                <DataGridTextColumn Header="Arrivals" Binding="{Binding Arrivals}" Width="90"/>
                                <DataGridTextColumn Header="Departures" Binding="{Binding Departures}" Width="90"/>
                                <DataGridTextColumn Header="Avg Wait (Wq)" Binding="{Binding AvgWait, StringFormat=F2}" Width="120"/>
                                <DataGridTextColumn Header="Avg Queue Len" Binding="{Binding AvgQueueLength, StringFormat=F2}" Width="120"/>
                                <DataGridTextColumn Header="Peak Queue Len" Binding="{Binding PeakQueueLength}" Width="120"/>
                                <DataGridTextColumn Header="Pump Util %" Binding="{Binding ServerUtilization, StringFormat={}{0:F1}%}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
