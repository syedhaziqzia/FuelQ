<UserControl x:Class="FuelQ.Views.ModelComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FuelQ.Controls"
             Background="{StaticResource CanvasBackground}"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <StackPanel>
                <TextBlock Text="Model Comparison &amp; Theoretical Benchmark"
                           Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Analytical vs Discrete-Event Convergence · Cross-Model Multi-Server Benchmarking"
                           Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── PARAMETER TOOLBAR ── -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Background="{StaticResource CardSurface}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="ARRIVAL (λ) veh/min" FontSize="8.5" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="TbLambda" Text="1.80"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                    <TextBlock Text="SERVICE (μ) veh/min" FontSize="8.5" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="TbMu" Text="2.20"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4,0,8,0">
                    <TextBlock Text="SERVER COUNT (C)" FontSize="8.5" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="TbC" Text="3"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="4,0,8,0">
                    <TextBlock Text="STD DEV (Σ) min" FontSize="8.5" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="TbSigma" Text="0.45"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="4,0,8,0">
                    <TextBlock Text="ERLANG SHAPE (K) phases" FontSize="8.5" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="TbK" Text="3"/>
                </StackPanel>
                <Button Grid.Column="5" Style="{StaticResource PrimaryButton}"
                        Content="⚙  Run Model Comparison"
                        Click="RunComparison_Click"
                        VerticalAlignment="Bottom" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- ── COMPARISON MATRIX ── -->
        <Border Grid.Row="2"
                Margin="20,10,20,0"
                Background="{StaticResource CardSurface}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Comparative Queue Metrics Matrix"
                                   Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="CalibrationLabel"
                                   Text="  ·  Calibration Delta: &lt; 2.1%  |  Confidence: 99.4%"
                                   FontSize="11" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="CompMatrix">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{StaticResource RowBase}"/>
                            <Setter Property="Foreground" Value="#B0C4DE"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{StaticResource RowAlternate}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsBestFit}" Value="True">
                                    <Setter Property="Background" Value="#0A1A30"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1A2D50"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Model Architecture" Binding="{Binding ModelName}"  Width="*" MinWidth="130"/>
                        <DataGridTextColumn Header="Type / Service Policy" Binding="{Binding TypeDesc}"  Width="*" MinWidth="130"/>
                        <DataGridTextColumn Header="Utilization (ρ)"      Binding="{Binding Rho}"        Width="*" MinWidth="85"/>
                        <DataGridTextColumn Header="In Queue (Lq)"        Binding="{Binding Lq}"         Width="*" MinWidth="85"/>
                        <DataGridTextColumn Header="Wait Time (Wq)"       Binding="{Binding Wq}"         Width="*" MinWidth="90"/>
                        <DataGridTextColumn Header="In System (L)"        Binding="{Binding L}"          Width="*" MinWidth="85"/>
                        <DataGridTextColumn Header="Total Time (W)"       Binding="{Binding W}"          Width="*" MinWidth="90"/>
                        <DataGridTextColumn Header="Idle Prob (P₀)"       Binding="{Binding P0}"         Width="*" MinWidth="80"/>
                        <DataGridTextColumn Header="Delay Prob (Pw)"      Binding="{Binding Pwait}"      Width="*" MinWidth="80"/>
                        <DataGridTextColumn Header="Best Fit Indicator"   Binding="{Binding BestFitBadge}" Width="*" MinWidth="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- ── BOTTOM: CHART + EFFICIENCY CARD ── -->
        <Grid Grid.Row="3" Margin="20,10,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Sensitivity Chart -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="0,0,8,0"
                    Padding="14,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="~  Congestion Explosion Sensitivity Curve"
                                   Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="  Lq vs ρ as traffic → saturation"
                                   FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                    </StackPanel>
                    <controls:SimpleWpfChart x:Name="SensitivityChart"
                                             Mode="Line"
                                             XAxisLabel="Traffic intensity ρ"
                                             YAxisLabel="Queue length Lq"/>
                </StackPanel>
            </Border>

            <!-- Efficiency + Export -->
            <StackPanel Grid.Column="1">
                <Border Background="{StaticResource CardSurface}"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="⚡ FORECOURT EFFICIENCY GAIN" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <Border Background="{StaticResource ActiveNavBg}" BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                <TextBlock Text="1-PUMP → 3-PUMPS" FontSize="8"
                                           Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="EfficiencyPct" Text="—"
                                   FontSize="42" FontWeight="Bold"
                                   Foreground="{StaticResource StatusGreenText}"/>
                        <TextBlock Text="QUEUE DROP" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,-4,0,8"/>
                        <TextBlock x:Name="EfficiencyDesc"
                                   Text="Run comparison to see results."
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" TextWrapping="Wrap"/>
                        <Separator Margin="0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Avg Wait (Wq): "
                                       FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="EffWq" Grid.Row="0" Grid.Column="1" Text="—"
                                       FontSize="10.5" Foreground="{StaticResource AccentCyanBrush}"
                                       FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Queue Depth (Lq): "
                                       FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="EffLq" Grid.Row="1" Grid.Column="1" Text="—"
                                       FontSize="10.5" Foreground="{StaticResource AccentCyanBrush}"
                                       FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Immediate Svc P: "
                                       FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="EffP0" Grid.Row="2" Grid.Column="1" Text="—"
                                       FontSize="10.5" Foreground="{StaticResource AccentCyanBrush}"
                                       FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource SecondaryButton}"
                        Content="⬇  Export LaTeX Table"
                        Click="ExportLatex_Click"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
