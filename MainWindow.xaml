<Window x:Class="FuelQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FuelQ — Shell Petrol Pump Maskan Branch Simulator"
        Height="600" Width="1000"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource CanvasBackground}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/AppLogo.jpg"
        FontFamily="Segoe UI">

    <Grid>
        <!-- ══════════════════════════════════
             IN-APP MODAL OVERLAY (ZIndex 1000)
             ══════════════════════════════════ -->
        <Grid x:Name="ModalOverlay" Panel.ZIndex="1000" Visibility="Collapsed">
            <Rectangle Fill="#CC050811"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="480" MaxWidth="720"
                    Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="12" Margin="40">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,14">
                        <Grid>
                            <TextBlock x:Name="ModalTitle" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5"
                                    Click="CloseModal_Click" FontSize="14"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" MaxHeight="500" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="ModalContent" Margin="20,16,20,20"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════════
             MAIN LAYOUT
             ════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ── -->
            <Border Grid.Column="0" x:Name="SidebarPanel" Width="260"
                    Background="{StaticResource SidebarSurface}"
                    BorderBrush="{StaticResource SidebarBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel ClipToBounds="True">

                    <!-- Top Brand Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,14">
                        <!-- Primary App Name row + collapse toggle -->
                        <Grid Margin="0,0,0,6">
                            <StackPanel x:Name="BrandLogoPanel" Orientation="Horizontal">
                                <Border CornerRadius="14" Margin="0,0,10,0" Width="64" Height="64" Background="#0C1B33" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                    <Border CornerRadius="13">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/AppLogo.jpg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="FuelQ" FontSize="14" FontWeight="Black" Foreground="White" Margin="0,0,6,0"/>
                                        <Border Background="#FBBF2422" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                            <TextBlock Text="SHELL" FontSize="9" FontWeight="Bold" Foreground="#FBBF24"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TbSidebarSubtitle" Text="Maskan Branch Simulator" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Sidebar collapse button -->
                            <Button x:Name="BtnToggleSidebar" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="◀" FontSize="10" Cursor="Hand"
                                    Foreground="{StaticResource TextSecondary}" Background="Transparent"
                                    BorderThickness="0" Padding="4,2" Margin="0,2,0,0"
                                    Click="ToggleSidebar_Click"
                                    ToolTip="Collapse sidebar"/>
                        </Grid>
                        <!-- Subtitle -->
                        <TextBlock x:Name="TbSidebarMeta" Text="GROUP G · UBIT · BSCS 6th Sem" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,2,0,1"/>
                    </StackPanel>

                    <!-- Section label -->
                    <TextBlock x:Name="TbNavLabel" DockPanel.Dock="Top" Text="NAVIGATION" Style="{StaticResource SectionLabel}" Margin="18,4,0,6"/>

                    <!-- Bottom Supervisor & Station Footer -->
                    <Border x:Name="PanelSupervisor" DockPanel.Dock="Bottom" Margin="12,0,12,16" Background="#061224"
                            BorderBrush="{StaticResource SidebarBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="SUPERVISOR" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="Dr. Shaista Rais" FontSize="12" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                            <TextBlock Text="Modeling &amp; Simulation" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            <Separator Background="{StaticResource CardBorder}" Margin="0,6,0,6"/>
                            <TextBlock Text="Shell Maskan Forecourt" FontSize="10.5" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="Group G (7 Members)" FontSize="9.5" Foreground="{StaticResource AccentCyanBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav Buttons -->
                    <StackPanel Margin="8,0,8,0">
                        <!-- 0: Home / Overview -->
                        <Button x:Name="NavBtn0" Style="{StaticResource NavButton}" Tag="0" Click="NavButton_Click" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🏠" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TbNavText0" Text="Home &amp; Team" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>

                        <!-- 1: Calculator -->
                        <Button x:Name="NavBtn1" Style="{StaticResource NavButton}" Tag="1" Click="NavButton_Click" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🧮" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TbNavText1" Text="Queue Calculator" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>

                        <!-- 2: DES Simulator -->
                        <Button x:Name="NavBtn2" Style="{StaticResource NavButton}" Tag="2" Click="NavButton_Click" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚙️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TbNavText2" Text="DES Simulator" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>

                        <!-- 3: AI Prompts & Audit -->
                        <Button x:Name="NavBtn3" Style="{StaticResource NavButton}" Tag="3" Click="NavButton_Click" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🤖" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TbNavText3" Text="AI Prompts &amp; Audit" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ── MAIN CONTENT ── -->
            <ContentControl Grid.Column="1" x:Name="MainContent" Background="{StaticResource CanvasBackground}"/>
        </Grid>
    </Grid>
</Window>
